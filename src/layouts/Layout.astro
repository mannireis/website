---
const { description = "A silly 14yo website", image = "/images/website.png" } =
    Astro.props;

const { title } = Astro.props;
const { path } = Astro.props;

import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import SidebarLeft from "../components/SidebarLeft.astro";
import SidebarRight from "../components/SidebarRight.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <ClientRouter />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.site)} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:type" content="website" />
        <meta name="description" content={description} />
    </head>
    <body>
        <main>
            <img
                src="/images/cover.png"
                alt="cover"
                class="cover-img"
                transition:persist
            />
            <div class="grid-container">
                <SidebarLeft transition:persist />
                <div class="main" transition:animate="fade">
                    <div class="title">
                        <h2>{path}</h2>
                    </div>
                    <slot />
                </div>
                <SidebarRight transition:persist />
            </div>
        </main>
    </body>
</html>

<style>
    .title > h2 {
        margin: 0;
    }
    .title {
        margin-top: 20px;
        margin-bottom: 20px;
        border-bottom: 4px solid var(--primary);
        border-top: 4px solid var(--primary);
        background-color: var(--foreground);
        display: flex;
        justify-content: center;
        padding: 10px;
    }
    .grid-container {
        display: grid;
        grid-template-columns: 1.1fr 4fr 1.1fr;
        min-height: calc(100vh - 230px);
    }

    .main {
        background-color: var(--background);
        min-width: 0;
    }

    .cover-img {
        display: block;
        width: 100%;
    }

    h3 {
        font-size: 16px;
        margin: 0;
    }

    @media (max-width: 750px) {
        body {
            padding-left: 0;
            padding-right: 0;
        }
        .grid-container {
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .grid-container > :global(:first-child) {
            order: 2;
        }

        .grid-container > :global(:nth-child(2)) {
            order: 1;
        }

        .grid-container > :global(:last-child) {
            order: 3;
        }
    }
</style>

<script>
    (() => {
        const CONFIG_PLACEHOLDER = null;
        const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
        const lerp = (a, b, t) => a + (b - a) * t;
        function loadImage(src) {
            return new Promise((res, rej) => {
                if (!src) return res(null);
                const i = new Image();
                i.onload = () => res(i);
                i.onerror = () => res(null);
                i.src = src;
            });
        }
        function roundRect(ctx, x, y, w, h, r) {
            const rr = Math.min(r, w / 2, h / 2);
            ctx.beginPath();
            ctx.moveTo(x + rr, y);
            ctx.arcTo(x + w, y, x + w, y + h, rr);
            ctx.arcTo(x + w, y + h, x, y + h, rr);
            ctx.arcTo(x, y + h, x, y, rr);
            ctx.arcTo(x, y, x + w, y, rr);
            ctx.closePath();
        }
        const isTouchDevice = () =>
            "ontouchstart" in window ||
            navigator.maxTouchPoints > 0 ||
            (window.matchMedia &&
                (window.matchMedia("(pointer: coarse)").matches ||
                    window.matchMedia("(hover: none)").matches));
        const prefersReduced = () =>
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.__createAnimatedCursor = async function (config) {
            if (isTouchDevice()) return; // restore normal cursor on touch devices
            const state = Object.assign(
                {
                    characterSrc: null,
                    characterSize: 96,
                    characterOffsetX: 18,
                    characterOffsetY: 18,
                    characterOpacity: 100,
                    eyeStyle: "normal",
                    eyeCustomSrc: null,
                    eyeTextureBoth: false,
                    eyeSize: 18,
                    eyeSpacing: 34,
                    eyePosX: 50,
                    eyePosY: 38,
                    eyeScleraColor: "#f5f7fb",
                    eyeIrisColor: "#1b2433",
                    eyePupilColor: "#06100b",
                    eyeIdleInterval: 1200,
                    eyeMoveAmount: 10,
                    crosshairStyle: "dot",
                    crosshairCustomSrc: null,
                    crosshairSize: 10,
                    crosshairThickness: 2,
                    crosshairColor: "#00e5ff",
                    crosshairBorderWidth: 2,
                    crosshairBorderColor: "#000000",
                    crosshairOpacity: 100,
                    trailAmount: 0,
                    trailColor: "#7c5cff",
                    squishAmount: 10,
                    eyeTrackAmount: 10,
                    hoverWidenAmount: 12,
                    floatAmount: 0,
                },
                config || {},
            );
            const [charImg, eyeImg, crossImg] = await Promise.all([
                loadImage(state.characterSrc),
                loadImage(state.eyeCustomSrc),
                loadImage(state.crosshairCustomSrc),
            ]);
            const canvas = document.createElement("canvas");
            const ctx = canvas.getContext("2d");
            canvas.style.position = "fixed";
            canvas.style.left = "0";
            canvas.style.top = "0";
            canvas.style.pointerEvents = "none";
            canvas.style.zIndex = "2147483647";
            canvas.style.willChange = "transform";
            document.documentElement.appendChild(canvas);
            const styleEl = document.createElement("style");
            styleEl.textContent =
                'html,body,*{cursor:none !important;} input,textarea,[contenteditable="true"]{cursor:none !important;}';
            document.head.appendChild(styleEl);

            let x = 0,
                y = 0,
                charX = 0,
                charY = 0,
                lastX = 0,
                lastY = 0,
                lookX = 0,
                lookY = 0,
                lookTX = 0,
                lookTY = 0,
                idleLookX = 0,
                idleLookY = 0,
                nextIdleLookAt = 0,
                lastMove = performance.now();
            let hover = false,
                down = false,
                squish = 0,
                blink = 0,
                blinking = false,
                phase = "closing",
                nextBlink = performance.now() + 2000 + Math.random() * 3000,
                doublePending = Math.random() < 0.18;
            let reduced = prefersReduced(),
                hotspot = 24;
            let trail = [];
            if (window.matchMedia) {
                const mq = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                );
                const h = () => (reduced = mq.matches);
                mq.addEventListener
                    ? mq.addEventListener("change", h)
                    : mq.addListener && mq.addListener(h);
            }
            function resize() {
                const trailPad = Math.max(0, +state.trailAmount || 0) * 10;
                const floatPad = Math.max(0, +state.floatAmount || 0) * 10;
                const pad = 160 + trailPad + floatPad;
                const crossHalf =
                    (+state.crosshairSize || 10) / 2 +
                    (+state.crosshairBorderWidth || 0) +
                    6;
                hotspot = Math.ceil(
                    Math.max(crossHalf + 120, 160 + trailPad + floatPad),
                );
                const w =
                    hotspot +
                    +state.characterSize +
                    Math.max(+state.characterOffsetX, 0) +
                    pad;
                const h =
                    hotspot +
                    +state.characterSize +
                    Math.max(+state.characterOffsetY, 0) +
                    pad;
                const dim = Math.ceil(Math.max(w, h, hotspot * 2 + 8));
                if (canvas.width !== dim || canvas.height !== dim) {
                    canvas.width = dim;
                    canvas.height = dim;
                    canvas.style.width = dim + "px";
                    canvas.style.height = dim + "px";
                }
            }
            resize();
            function isInteractive(el) {
                return !!(
                    el &&
                    el.closest &&
                    el.closest(
                        'a,button,input,textarea,select,label,summary,[role="button"],[role="link"],[onclick],[contenteditable="true"]',
                    )
                );
            }
            function updateHover(e) {
                const el = document.elementFromPoint(e.clientX, e.clientY);
                hover = isInteractive(el);
            }
            window.addEventListener(
                "pointermove",
                (e) => {
                    const dx = e.clientX - lastX,
                        dy = e.clientY - lastY;
                    lastX = e.clientX;
                    lastY = e.clientY;
                    x = e.clientX;
                    y = e.clientY;
                    lastMove = performance.now();
                    const mag = Math.hypot(dx, dy) || 1;
                    const trackStrength =
                        Math.max(
                            0,
                            +state.eyeTrackAmount == null
                                ? 10
                                : +state.eyeTrackAmount,
                        ) / 10;
                    const amt =
                        Math.min(1, Math.hypot(dx, dy) / 25) * trackStrength;
                    lookTX = (dx / mag) * amt;
                    lookTY = (dy / mag) * amt;
                    updateHover(e);
                },
                { passive: true },
            );
            window.addEventListener("pointerover", updateHover, {
                passive: true,
            });
            window.addEventListener(
                "pointerdown",
                (e) => {
                    down = true;
                    squish = 1;
                    lastMove = performance.now();
                    updateHover(e);
                },
                { passive: true },
            );
            window.addEventListener(
                "pointerup",
                () => {
                    down = false;
                },
                { passive: true },
            );
            window.addEventListener(
                "touchstart",
                () => {
                    // disable on touch
                    canvas.remove();
                    styleEl.remove();
                },
                { passive: true, once: true },
            );

            function scheduleBlink(now) {
                nextBlink = now + 2200 + Math.random() * 3200;
                doublePending = Math.random() < 0.18;
            }
            function updateBlink(now, dt) {
                if (reduced) {
                    blink = 0;
                    return;
                }
                if (!blinking && now >= nextBlink) {
                    blinking = true;
                    phase = "closing";
                }
                if (blinking) {
                    const speed = dt / 90;
                    if (phase === "closing") {
                        blink = Math.min(1, blink + speed);
                        if (blink >= 1) phase = "opening";
                    } else {
                        blink = Math.max(0, blink - speed);
                        if (blink <= 0) {
                            blinking = false;
                            if (doublePending) {
                                doublePending = false;
                                blinking = true;
                                phase = "closing";
                                nextBlink = now + 999999;
                            } else scheduleBlink(now);
                        }
                    }
                }
            }
            function drawCrosshair(hx, hy) {
                const size = +state.crosshairSize,
                    color = state.crosshairColor || "#00e5ff",
                    bWidth = Math.max(0, +state.crosshairBorderWidth || 0),
                    bColor = state.crosshairBorderColor || "#000000",
                    style = state.crosshairStyle;
                const alpha = Math.max(
                    0.1,
                    Math.min(
                        1,
                        (+state.crosshairOpacity == null
                            ? 100
                            : +state.crosshairOpacity) / 100,
                    ),
                );
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.translate(hx, hy);
                if (crossImg) {
                    if (bWidth > 0) {
                        ctx.strokeStyle = bColor;
                        ctx.lineWidth = bWidth;
                        ctx.strokeRect(
                            -size / 2 - bWidth / 2,
                            -size / 2 - bWidth / 2,
                            size + bWidth,
                            size + bWidth,
                        );
                    }
                    ctx.drawImage(crossImg, -size / 2, -size / 2, size, size);
                    ctx.restore();
                    return;
                }
                const baseLine = Math.max(
                    1,
                    +state.crosshairThickness || Math.max(1.5, size * 0.18),
                );
                const drawDot = (r, fill) => {
                    ctx.beginPath();
                    ctx.arc(0, 0, r, 0, Math.PI * 2);
                    ctx.fillStyle = fill;
                    ctx.fill();
                };
                if (style === "dot") {
                    const r = Math.max(1.5, size * 0.22);
                    if (bWidth > 0) drawDot(r + bWidth, bColor);
                    drawDot(r, color);
                } else if (style === "cross") {
                    const arm = size * 0.5,
                        gap = size * 0.12;
                    const path = () => {
                        ctx.beginPath();
                        ctx.moveTo(-arm, 0);
                        ctx.lineTo(-gap, 0);
                        ctx.moveTo(gap, 0);
                        ctx.lineTo(arm, 0);
                        ctx.moveTo(0, -arm);
                        ctx.lineTo(0, -gap);
                        ctx.moveTo(0, gap);
                        ctx.lineTo(0, arm);
                    };
                    ctx.lineCap = "round";
                    if (bWidth > 0) {
                        path();
                        ctx.strokeStyle = bColor;
                        ctx.lineWidth = baseLine + bWidth * 2;
                        ctx.stroke();
                    }
                    path();
                    ctx.strokeStyle = color;
                    ctx.lineWidth = baseLine;
                    ctx.stroke();
                } else if (style === "ring") {
                    const r = size * 0.4,
                        inner = Math.max(1, size * 0.08);
                    if (bWidth > 0) {
                        ctx.beginPath();
                        ctx.arc(0, 0, r, 0, Math.PI * 2);
                        ctx.strokeStyle = bColor;
                        ctx.lineWidth = baseLine + bWidth * 2;
                        ctx.stroke();
                        drawDot(inner + bWidth, bColor);
                    }
                    ctx.beginPath();
                    ctx.arc(0, 0, r, 0, Math.PI * 2);
                    ctx.strokeStyle = color;
                    ctx.lineWidth = baseLine;
                    ctx.stroke();
                    drawDot(inner, color);
                } else if (style === "chevron") {
                    const s = size * 0.45;
                    const path = () => {
                        ctx.beginPath();
                        ctx.moveTo(-s, -s * 0.2);
                        ctx.lineTo(0, s * 0.5);
                        ctx.lineTo(s, -s * 0.2);
                    };
                    ctx.lineCap = "round";
                    ctx.lineJoin = "round";
                    if (bWidth > 0) {
                        path();
                        ctx.strokeStyle = bColor;
                        ctx.lineWidth = baseLine + bWidth * 2;
                        ctx.stroke();
                    }
                    path();
                    ctx.strokeStyle = color;
                    ctx.lineWidth = baseLine;
                    ctx.stroke();
                }
                ctx.restore();
            }
            function drawProceduralEye(ex, ey, size, sleepyAmt) {
                const r = size / 2;
                const b = Math.max(blink, sleepyAmt * 0.75);
                const open = 1 - b;
                const lookPx = r * 0.28;
                const moveAmt =
                    Math.max(
                        0,
                        +state.eyeMoveAmount == null
                            ? 10
                            : +state.eyeMoveAmount,
                    ) / 10;
                const eex = ex + lookX * lookPx * moveAmt,
                    eey = ey + lookY * lookPx * moveAmt;
                ctx.save();
                ctx.translate(eex, eey);
                if (state.eyeStyle !== "happy") {
                    ctx.save();
                    ctx.scale(1, Math.max(0.06, open));
                    ctx.beginPath();
                    ctx.ellipse(0, 0, r, r * 0.72, 0, 0, Math.PI * 2);
                    ctx.fillStyle = state.eyeScleraColor || "#f5f7fb";
                    ctx.fill();
                    ctx.strokeStyle = "rgba(0,0,0,0.25)";
                    ctx.lineWidth = Math.max(1, r * 0.08);
                    ctx.stroke();
                    ctx.save();
                    ctx.beginPath();
                    ctx.ellipse(0, 0, r * 0.95, r * 0.68, 0, 0, Math.PI * 2);
                    ctx.clip();
                    if (state.eyeStyle === "normal") {
                        ctx.beginPath();
                        ctx.arc(0, 0, r * 0.38, 0, Math.PI * 2);
                        ctx.fillStyle = state.eyeIrisColor || "#1b2433";
                        ctx.fill();
                        ctx.beginPath();
                        ctx.arc(-r * 0.12, -r * 0.12, r * 0.12, 0, Math.PI * 2);
                        ctx.fillStyle = "rgba(255,255,255,0.9)";
                        ctx.fill();
                    } else if (state.eyeStyle === "solid") {
                        ctx.beginPath();
                        ctx.ellipse(0, 0, r * 0.55, r * 0.5, 0, 0, Math.PI * 2);
                        ctx.fillStyle = state.eyeIrisColor || "#05070a";
                        ctx.fill();
                    } else if (state.eyeStyle === "cat") {
                        ctx.beginPath();
                        ctx.ellipse(
                            0,
                            0,
                            r * 0.34,
                            r * 0.46,
                            0,
                            0,
                            Math.PI * 2,
                        );
                        ctx.fillStyle = state.eyeIrisColor || "#1d7f4f";
                        ctx.fill();
                        ctx.beginPath();
                        ctx.ellipse(
                            0,
                            0,
                            r * 0.09,
                            r * 0.38,
                            0,
                            0,
                            Math.PI * 2,
                        );
                        ctx.fillStyle = state.eyePupilColor || "#06100b";
                        ctx.fill();
                    }
                    ctx.restore();
                    ctx.restore();
                    if (b > 0.01) {
                        ctx.save();
                        ctx.beginPath();
                        ctx.ellipse(
                            0,
                            0,
                            r * 1.02,
                            r * 0.74,
                            0,
                            0,
                            Math.PI * 2,
                        );
                        ctx.clip();
                        ctx.fillStyle = "rgba(20,24,33,0.92)";
                        const lidH = r * 1.6 * b;
                        ctx.fillRect(
                            -r * 1.2,
                            -r * 0.8 - (r * 1.6 - lidH),
                            r * 2.4,
                            r * 1.6,
                        );
                        ctx.restore();
                    }
                } else {
                    ctx.strokeStyle = state.eyeIrisColor || "#1b2433";
                    ctx.lineWidth = Math.max(2, r * 0.18);
                    ctx.lineCap = "round";
                    ctx.beginPath();
                    ctx.arc(
                        0,
                        r * 0.1,
                        r * 0.7,
                        Math.PI * 0.15,
                        Math.PI * 0.85,
                    );
                    ctx.stroke();
                }
                ctx.restore();
            }
            function drawEyes(now, ox, oy, charSize) {
                const eyeY = oy + (+state.eyePosY / 100) * charSize;
                const centerX = ox + (+state.eyePosX / 100) * charSize;
                const spacing = +state.eyeSpacing / 2;
                const base = +state.eyeSize;
                const idle = now - lastMove;
                const sleepy = idle > 4000;
                const sleepyAmt = sleepy
                    ? clamp((idle - 4000) / 1500, 0, 1)
                    : 0;
                const widenAmt =
                    Math.max(
                        0,
                        +state.hoverWidenAmount == null
                            ? 12
                            : +state.hoverWidenAmount,
                    ) / 100;
                const widen = hover ? 1 + widenAmt : 1.0;
                const left = { x: centerX - spacing, y: eyeY },
                    right = { x: centerX + spacing, y: eyeY };
                const b = Math.max(blink, sleepyAmt * 0.75),
                    open = 1 - b;
                const lookPx = base * widen * 0.12,
                    lx = lookX * lookPx,
                    ly = lookY * lookPx;
                if (eyeImg) {
                    const ratio =
                        (eyeImg.naturalWidth || eyeImg.width || 1) /
                        (eyeImg.naturalHeight || eyeImg.height || 1);
                    const moveAmt =
                        Math.max(
                            0,
                            +state.eyeMoveAmount == null
                                ? 10
                                : +state.eyeMoveAmount,
                        ) / 10;
                    if (state.eyeTextureBoth) {
                        const w = Math.max(
                            1,
                            +state.eyeSpacing * 2.2,
                            base * widen * 2,
                        );
                        const h = w / ratio;
                        ctx.save();
                        ctx.translate(
                            (left.x + right.x) / 2 + lx * moveAmt,
                            (left.y + right.y) / 2 + ly * moveAmt,
                        );
                        ctx.scale(1, Math.max(0.05, open));
                        ctx.drawImage(eyeImg, -w / 2, -h / 2, w, h);
                        ctx.restore();
                    } else {
                        const h = base * widen,
                            w = h * ratio;
                        [left, right].forEach((p) => {
                            ctx.save();
                            ctx.translate(
                                p.x + lx * moveAmt,
                                p.y + ly * moveAmt,
                            );
                            ctx.scale(1, Math.max(0.05, open));
                            ctx.drawImage(eyeImg, -w / 2, -h / 2, w, h);
                            ctx.restore();
                        });
                    }
                } else {
                    drawProceduralEye(left.x, left.y, base * widen, sleepyAmt);
                    drawProceduralEye(
                        right.x,
                        right.y,
                        base * widen,
                        sleepyAmt,
                    );
                }
            }
            let lastNow = performance.now();
            function frame(now) {
                const dt = Math.min(50, now - lastNow);
                lastNow = now;
                canvas.style.transform =
                    "translate3d(" +
                    (x - hotspot) +
                    "px," +
                    (y - hotspot) +
                    "px,0)";
                if (!reduced) {
                    if (!nextIdleLookAt || now >= nextIdleLookAt) {
                        const idle = now - lastMove;
                        const amp = idle > 800 ? 0.55 : 0.3;
                        idleLookX = (Math.random() * 2 - 1) * amp;
                        idleLookY = (Math.random() * 2 - 1) * amp * 0.7;
                        const interval = Math.max(
                            200,
                            +(state.eyeIdleInterval == null
                                ? 1200
                                : state.eyeIdleInterval),
                        );
                        nextIdleLookAt = now + interval * (0.5 + Math.random());
                    }
                } else {
                    idleLookX = 0;
                    idleLookY = 0;
                }
                const combinedLookX = lookTX + idleLookX,
                    combinedLookY = lookTY + idleLookY;
                const ease = reduced ? 1 : 0.18;
                lookX = lerp(lookX, combinedLookX, ease);
                lookY = lerp(lookY, combinedLookY, ease);
                lookTX = lerp(lookTX, 0, 0.08);
                lookTY = lerp(lookTY, 0, 0.08);
                const floatAmt = Math.max(0, +state.floatAmount || 0);
                if (floatAmt <= 0) {
                    charX = x;
                    charY = y;
                } else {
                    const fe = Math.max(0.04, 0.35 - floatAmt * 0.015);
                    charX = lerp(charX, x, fe);
                    charY = lerp(charY, y, fe);
                }
                const target = down ? 1 : 0;
                squish = reduced ? 0 : lerp(squish, target, 0.35);
                if (!down && squish < 0.01) squish = 0;
                // trail history
                const trailAmount = Math.max(0, +state.trailAmount || 0);
                if (trailAmount > 0 && !reduced) {
                    const last = trail[trail.length - 1];
                    if (
                        !last ||
                        Math.hypot(charX - last.x, charY - last.y) > 0.5
                    )
                        trail.push({ x: charX, y: charY });
                    const maxTrail = Math.max(4, trailAmount * 2);
                    if (trail.length > maxTrail)
                        trail.splice(0, trail.length - maxTrail);
                } else if (trailAmount === 0 || reduced) {
                    trail.length = 0;
                }

                updateBlink(now, dt);
                const w = canvas.width,
                    h = canvas.height;
                ctx.clearRect(0, 0, w, h);
                const hx = hotspot,
                    hy = hotspot;
                const charOffsetX = charX - x,
                    charOffsetY = charY - y;
                const ox = hx + +state.characterOffsetX + charOffsetX,
                    oy = hy + +state.characterOffsetY + charOffsetY,
                    cs = +state.characterSize;
                const charAlpha = Math.max(
                    0.1,
                    Math.min(
                        1,
                        (+state.characterOpacity == null
                            ? 100
                            : +state.characterOpacity) / 100,
                    ),
                );
                const squishStrength =
                    Math.max(
                        0,
                        +state.squishAmount == null ? 10 : +state.squishAmount,
                    ) / 10;
                if (trailAmount > 0 && !reduced && trail.length > 1) {
                    const step = Math.max(
                        1,
                        Math.floor(
                            trail.length / Math.min(trail.length, trailAmount),
                        ),
                    );
                    for (let i = 0; i < trail.length - 1; i += step) {
                        const p = trail[i];
                        const t = i / Math.max(1, trail.length - 1);
                        const alpha = t * 0.25 * (trailAmount / 20);
                        const dx = p.x - x,
                            dy = p.y - y;
                        const tx = hx + +state.characterOffsetX + dx,
                            ty = hy + +state.characterOffsetY + dy;
                        ctx.save();
                        ctx.globalAlpha = alpha;
                        if (charImg) ctx.drawImage(charImg, tx, ty, cs, cs);
                        else {
                            ctx.fillStyle =
                                state.trailColor || "rgba(124,92,255,0.35)";
                            roundRect(
                                ctx,
                                tx + cs * 0.15,
                                ty + cs * 0.05,
                                cs * 0.7,
                                cs * 0.85,
                                cs * 0.2,
                            );
                            ctx.fill();
                        }
                        ctx.restore();
                    }
                }
                const sx = 1 + squish * 0.08 * squishStrength,
                    sy = 1 - squish * 0.1 * squishStrength,
                    ccx = ox + cs / 2,
                    ccy = oy + cs / 2;
                ctx.save();
                ctx.translate(ccx, ccy);
                ctx.scale(sx, sy);
                ctx.translate(-ccx, -ccy);
                ctx.globalAlpha = charAlpha;
                if (charImg) ctx.drawImage(charImg, ox, oy, cs, cs);
                else {
                    ctx.fillStyle = "rgba(124,92,255,0.25)";
                    ctx.strokeStyle = "rgba(124,92,255,0.6)";
                    ctx.lineWidth = 2;
                    roundRect(
                        ctx,
                        ox + cs * 0.15,
                        oy + cs * 0.05,
                        cs * 0.7,
                        cs * 0.85,
                        cs * 0.2,
                    );
                    ctx.fill();
                    ctx.stroke();
                }
                ctx.globalAlpha = 1;
                drawEyes(now, ox, oy, cs);
                ctx.restore();
                if (hover) drawCrosshair(hx, hy);
                requestAnimationFrame(frame);
            }
            requestAnimationFrame(frame);
        };
        window.__createAnimatedCursor &&
            window.__createAnimatedCursor({
                characterSrc:
                    "data:image/png;base64,",
                characterSize: 48,
                characterOffsetX: 0,
                characterOffsetY: 0,
                eyeStyle: "solid",
                eyeCustomSrc:
                    "data:image/png;base64,",
                eyeTextureBoth: false,
                eyeSize: 12,
                eyeSpacing: 14,
                eyePosX: 50,
                eyePosY: 50,
                crosshairStyle: "cross",
                crosshairCustomSrc: null,
                crosshairSize: 11,
                crosshairThickness: 3,
                crosshairColor: "#860d88",
                crosshairBorderWidth: 1,
                crosshairBorderColor: "#0f0f0f",
                trailAmount: 0,
                trailColor: "#7c5cff",
                squishAmount: 14,
                eyeTrackAmount: 10,
                hoverWidenAmount: 10,
                characterOpacity: 100,
                eyeScleraColor: "#f5f7fb",
                eyeIrisColor: "#1b2433",
                eyePupilColor: "#06100b",
                eyeIdleInterval: 1200,
                eyeMoveAmount: 30,
                crosshairOpacity: 100,
                floatAmount: 3,
            });
    })();
</script>
