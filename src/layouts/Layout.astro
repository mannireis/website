---
const { description = "A silly 14yo website", image = "/images/website.png" } =
    Astro.props;

const { title } = Astro.props;
const { path } = Astro.props;

import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import SidebarLeft from "../components/SidebarLeft.astro";
import SidebarRight from "../components/SidebarRight.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <ClientRouter />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.site)} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:type" content="website" />
        <meta name="description" content={description} />
    </head>
    <body>
        <main>
            <img
                src="/images/cover.png"
                alt="cover"
                class="cover-img"
                transition:persist
            />
            <div class="grid-container">
                <SidebarLeft transition:persist />
                <div class="main" transition:animate="fade">
                    <div class="title">
                        <h2>{path}</h2>
                    </div>
                    <slot />
                </div>
                <SidebarRight transition:persist />
            </div>
        </main>
    </body>
</html>

<style>
    .title > h2 {
        margin: 0;
    }
    .title {
        margin-top: 20px;
        margin-bottom: 20px;
        border-bottom: 4px solid #abcfa0;
        border-top: 4px solid #abcfa0;
        background-color: #374341;
        display: flex;
        justify-content: center;
        padding: 10px;
    }
    .grid-container {
        display: grid;
        grid-template-columns: 1.1fr 4fr 1.1fr;
        min-height: calc(100vh - 230px);
    }

    .main {
        background-color: #28312f;
        min-width: 0;
    }

    .cover-img {
        display: block;
        width: 100%;
    }

    h3 {
        font-size: 16px;
        margin: 0;
    }

    @media (max-width: 750px) {
        body {
            padding-left: 0;
            padding-right: 0;
        }
        .grid-container {
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .grid-container > :global(:first-child) {
            order: 2;
        }

        .grid-container > :global(:nth-child(2)) {
            order: 1;
        }

        .grid-container > :global(:last-child) {
            order: 3;
        }
    }
</style>
