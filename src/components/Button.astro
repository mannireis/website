---
const { link } = Astro.props;
---

<a href={link}>
    <slot />
</a>

<style>
    a {
        display: block;
        text-decoration: none;
        transform: scale(1);
        transition: transform 150ms linear;
    }

    a:hover {
        text-decoration: none;
        transform: scale(1.25);
        transition: transform 150ms linear;
    }
</style>
