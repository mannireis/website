---
interface Props {
    title: string;
    description: string;
    image: string;
    github: string;
    tags: string[];
}

const { title, description, image, github, tags } = Astro.props;
---

<div class="project-card">
    <img src={image} alt={title} class="project-image" />
    <div class="project-content">
        <h3 class="project-title">{title}</h3>
        <p class="project-description">{description}</p>
        <div class="project-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <a href={github} class="project-link" target="_blank">View on GitHub</a>
    </div>
</div>

<style>
    .project-card {
        border: 3px solid var(--primary);
        border-radius: 10px;
        padding: 15px;
        margin: 15px 0;
        background: var(--background);
    }

    .project-image {
        width: 100%;
        max-height: 200px;
        object-fit: cover;
        border-radius: 8px;
    }

    .project-title {
        margin: 10px 0;
        color: var(--text);
    }

    .project-description {
        color: var(--text);
        margin: 10px 0;
    }

    .project-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin: 10px 0;
    }

    .tag {
        background: var(--primary);
        color: var(--background);
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .project-link {
        display: inline-block;
        margin-top: 10px;
        color: var(--text);
    }
</style>
