---
interface Props {
    title: string;
    description: string;
    image: string;
    github: string;
    tags: string[];
}

const { title, description, image, github, tags } = Astro.props;
---

<a class="project-card" href={github}>
    <img src={image} alt={title} class="project-image" />
    <h3 class="project-title">{title}</h3>
    <p class="project-description">{description}</p>
</a>

<style>
    a:hover {
        color: #fbedda;
        text-decoration: none;
        border-color: #fbedda;
    }
    .project-card {
        border: 3px solid var(--primary);
        border-radius: 10px;
        padding: 10px;
        background: var(--background);
    }

    .project-image {
        width: 100%;
        max-height: 200px;
        object-fit: cover;
        border-radius: 8px;
    }

    .project-title {
        color: var(--text);
    }

    .project-description {
        color: var(--text);
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .tag {
        background: var(--primary);
        color: var(--background);
        border-radius: 15px;
        padding: 5px;
    }

    .project-link {
        margin-bottom: 5px;
        display: inline-block;
        color: var(--text);
    }
</style>
