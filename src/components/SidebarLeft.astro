---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
---

<div class="container sidebar-left">
    <div>
        <h2>main</h2>
        <a href="/">home</a>
        <a href="/about">about me :3</a>
        <a href="/contact">contact</a>
    </div>
    <div>
        <h2>my stuff</h2>
        <a href="/projects">projects</a>
        <a href="/art">art</a>
        <a href="/photos">photos</a>
        <a href="/blog">blog</a>
    </div>
    <div>
        <h2>blog posts</h2>
        {
            posts.map((post) => (
                <a href={`/blog/${post.id}`} class="title-link">
                    {post.data.title}
                </a>
            ))
        }
    </div>
    <div></div>
</div>

<style>
    h2 {
        padding-left: 10px;
        padding-top: 3px;
        padding-bottom: 5px;
        background-color: #374341;
        border-bottom: 4px solid #abcfa0;
        margin: 0;
    }

    a:hover {
        color: #fbedda;
        text-decoration: wavy underline #abcfa0;
    }

    a {
        -webkit-line-clamp: 1;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;

        line-clamp: 1;

        color: #fdf6ec;
        padding: 10px 0px 10px 10px;
        background-color: #28312f;
        border-left: 6px solid #374341;
        border-bottom: 2px solid #374341;
        text-decoration: none;
        height: 1em;
    }

    .container {
        border-right: 4px solid #abcfa0;
        background-color: #28312f;
    }
    @media (max-width: 750px) {
        .container {
            border-right: none;
        }
    }
</style>
