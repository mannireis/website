---
import Layout from "../layouts/Layout.astro";
import Separator from "../components/Separator.astro";
import Header from "../components/Header.astro";
---

<Layout title="manni/home" path="home">
    <div class="content">
        <Header title="About Me" />
        <div class="aboutmediv">
            <p>
                Lorem, ipsum dolor sit amet consectetur adipisicing elit. Rerum
                eveniet porro nemo ducimus totam accusantium soluta sit sint
                cumque! Natus ratione pariatur minima similique, reprehenderit
                voluptatem nam omnis sit voluptates. Lorem ipsum dolor sit, amet
                consectetur adipisicing elit. Odit, veniam. Suscipit placeat in
                tempora quia, accusamus cumque doloribus ut earum corporis
                debitis distinctio velit exercitationem aspernatur? Nostrum
                debitis tempore facere.
            </p>
        </div>

        <Separator />
        <div class="latest">
            <h4>Latest Update:</h4>
            <p id="commit-message"></p>
        </div>

        <Header title="Projects:" />
        <div class="projects">
            <div></div>
        </div>
    </div>
</Layout>

<style>
    .latest > h4 {
        margin: 10px;
    }
    .content {
        text-align: center;
    }
    .aboutmediv {
        margin: 20px;
        text-align: center;
    }
</style>

<script>
    fetch("https://api.github.com/repos/mannireis/website/commits/main")
        .then((res) => res.json())
        .then((data) => {
            document.getElementById("commit-message").textContent =
                data.commit.message;
        })
        .catch((err) => console.error(err));
</script>
