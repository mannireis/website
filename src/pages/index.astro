---
import Layout from "../layouts/Layout.astro";
import Separator from "../components/Separator.astro";
import Header from "../components/Header.astro";
import Posts from "../components/Posts.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../data/projects";
---

<Layout title="manni/home" path="home">
    <div class="content">
        <Header title="About Me" />
        <div class="aboutmediv">
            <p>
                Haii im manni (they/them), a 14yo hacker. I like to make silly
                and useful projects, check them <a href="/projects">here</a>.
                I'm also homeschooled, I read a lot, I draw and talk a lot in
                the <a href="https://hackclub.com/">hack club slack</a>. I'm
                trying to write more too, go check them out <a href="blog/"
                    >here</a
                >. I really like Minecraft, PCBs, Kicad, Godot, Aseprite and
                Celeste!! :3c
            </p>
        </div>

        <Separator />
        <div class="latest">
            <h4>Latest Update:</h4>
            <p id="commit-message"></p>
        </div>

        <Header title="Projects:" />
        <div class="projects">
            {
                featuredProjects.map((project) => (
                    <ProjectCard
                        title={project.title}
                        description={project.description}
                        image={project.image}
                        github={project.github}
                        tags={[...project.tags]}
                    />
                ))
            }
            <p class="view-more-proj">
                <a href="/projects">View all projects</a>
            </p>
        </div>
        <Header title="Posts:" />
        <div class="blog-posts">
            <Posts limit={3} />
            <div class="view-more-blog">
                <a href="/blog">View all posts</a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .latest > h4 {
        margin: 10px;
    }
    .content {
        text-align: center;
    }
    .blog-posts,
    .aboutmediv {
        margin: 20px;
        text-align: center;
    }
    .projects {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 10px;
        padding: 10px;
    }
    .view-more-proj {
        grid-column: 1 / -1;
    }

    .view-more-blog {
        margin: 20px;
    }
</style>

<script>
    fetch("https://api.github.com/repos/mannireis/website/commits/main")
        .then((res) => res.json())
        .then((data) => {
            document.getElementById("commit-message").textContent =
                data.commit.message;
        })
        .catch((err) => console.error(err));
</script>
